[gd_resource type="Resource" script_class="ChapterData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/story/chapter_data.gd" id="1_chdata"]
[ext_resource type="Resource" path="res://data/maps/park_map.tres" id="2_map"]

[resource]
script = ExtResource("1_chdata")
id = &"ch2"
number = 2
title = "Hierba entre las ruinas"
tagline = "Donde hubo juegos, ahora crece la maleza... y algo mas."
map = ExtResource("2_map")
cinematic_panels = Array[Dictionary]([{
"body": "El barrio respira de nuevo, y la colonia mira mas alla de la ultima calle: el viejo parque, verde y silencioso.",
"kind": &"park",
"title": "El parque"
}, {
"body": "Entre los arbustos hay gatos escondidos que nunca llegaron a los tejados. Y la jauria tambien los ha oido.",
"kind": &"dogs",
"title": "Ecos en la maleza"
}, {
"body": "La gata afila las uñas en la corteza de un arbol muerto. Hoy no se trata de sobrevivir: se trata de volver con todos.",
"kind": &"hero",
"title": "Nadie se queda atras"
}])
first_clear_reward = 100
accent_color = Color(0.55, 0.9, 0.42, 1)
