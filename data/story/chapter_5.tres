cinematic_panels = Array[Dictionary]([{
"body": "La maleza del parque se volvio negra. En su centro, la plaga ha hecho nido.",
"kind": &"park_dark",
"title": "El bosque enfermo"
}, {
"body": "Hay maullidos dentro del nido. Gatos vivos, rodeados, contando las horas.",
"kind": &"cats",
"title": "Los atrapados"
}, {
"body": "Dos centinelas guardan el corazon del parque. La gata no piensa pedir permiso.",
"kind": &"hero",
"title": "Entrar y salir con todos"
}])
