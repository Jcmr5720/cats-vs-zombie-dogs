[gd_resource type="Resource" script_class="ChapterData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/story/chapter_data.gd" id="1_chdata"]
[ext_resource type="Resource" path="res://data/maps/neighborhood_map.tres" id="2_map"]

[resource]
script = ExtResource("1_chdata")
id = &"ch1"
number = 1
title = "El ultimo tejado"
tagline = "Todo empieza con una gata que no huye."
map = ExtResource("2_map")
cinematic_panels = Array[Dictionary]([{
"body": "Cuando la plaga llego, los humanos se fueron. Las calles quedaron para los perros... y para lo que la plaga hizo con ellos.",
"kind": &"city",
"title": "La ciudad callo"
}, {
"body": "Ojos verdes en la oscuridad. Ladridos que ya no son de perro. El barrio entero huele a oxido y a miedo.",
"kind": &"dogs",
"title": "La jauria"
}, {
"body": "En los tejados sobreviven los gatos: dispersos, hambrientos, esperando a que alguien baje primero.",
"kind": &"cats",
"title": "La colonia"
}, {
"body": "Esta noche, una gata baja del tejado. Si el barrio ha de ser de alguien, sera de la colonia.",
"kind": &"hero",
"title": "La gata que abre camino"
}])
first_clear_reward = 80
accent_color = Color(0.45, 0.9, 1, 1)
