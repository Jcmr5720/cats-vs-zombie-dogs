cinematic_panels = Array[Dictionary]([{
"body": "Mas alla del parque empiezan las fabricas. Ningun gato ha vuelto jamas del callejon industrial.",
"kind": &"factory",
"title": "La zona muerta"
}, {
"body": "Alli los perros son mas grandes, mas duros de tumbar. La plaga los usa de muralla.",
"kind": &"dogs",
"title": "Los capataces"
}, {
"body": "Si la colonia quiere respuestas, alguien tiene que derribar a los guardianes. La gata ya va en camino.",
"kind": &"hero",
"title": "Abrir la puerta"
}])
