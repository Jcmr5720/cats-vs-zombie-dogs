; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CatsVsZombieDogs"
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Feedback="*res://scripts/systems/feedback_manager.gd"
Performance="*res://scripts/systems/performance_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Missions="*res://scripts/systems/mission_manager.gd"
Shelter="*res://scripts/shelter/shelter_manager.gd"
MetaProgression="*res://scripts/meta/permanent_upgrade_manager.gd"
Settings="*res://scripts/systems/settings_manager.gd"
GameFlow="*res://scripts/systems/game_flow_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

